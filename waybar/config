{
    "layer": "top",
    "position": "top",
    "height": 31,
    "spacing": 0,
    "margin-top": 2,
    "margin-left": 5,
    "margin-right": 5,
    "exclusive": true,
    "passthrough": false,

    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
        "wlr/taskbar"
    ],

    "modules-center": [],

    "modules-right": [
        "custom/dunst",
        "tray",
        "pulseaudio",
        "backlight",
        "temperature#cpu",
        "custom/gputemp",
        "memory",
        "network",
        "battery",
        "clock#time",
        "clock#date",
        "custom/power"
    ],

    // ─── LEFT ────────────────────────────────────────────────

    "custom/arch": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Application Launcher",
        "on-click": "hyprlauncher"
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": [1, 2]
        },
        "tooltip": false
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "icon-theme": "Papirus",
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [],
        "app_ids-mapping": {}
    }, 

    // ─── RIGHT ───────────────────────────────────────────────

    // Dunst notification toggle (no swaync needed)
    "custom/dunst": {
        "exec": "~/.config/waybar/scripts/dunst.sh",
        "on-click": "~/.config/waybar/scripts/dunst_toggle.sh",
        "interval": 2,
        "tooltip": false
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8,
        "show-passive-items": false,
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        // wpctl for volume — no pavucontrol needed
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc}",
        "smooth-scrolling-threshold": 1
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "  {icon} {percent}%  ",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip-format": "Brightness",
        "smooth-scrolling-threshold": 1
    },

    "temperature#cpu": {
        "hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",
        "critical-threshold": 95,
        "format": "  󰍛 {temperatureC}°C  ",
        "tooltip": true,
        "tooltip-format": "CPU Temp"
    },

    "custom/gputemp": {
        "exec": "~/.config/waybar/scripts/gpu_temp.sh",
        "interval": 5,
        "tooltip": true,
        "tooltip-format": "GPU Temp"
    },

    "memory": {
        "interval": 5,
        "format": "󰍛 {used:.1f}G",
        "tooltip-format": "Used: {used:.2f} GiB / {total:.2f} GiB\nSwap: {swapUsed:.2f} / {swapTotal:.2f} GiB"
    },

    "network": {
        "interval": 20,
        "interface": "wlp2s0",
        "format-wifi": "󰤨 {signalStrength}%",
        "format-ethernet": "󰈀 on",
        "format-disconnected": "󰤭 off",
        "format-linked": "󰈀 no ip",
        "on-click": "kitty --class nmtui -e nmtui",
        "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\nHealth: {health}%"
    },

    "clock#time": {
        "format": "󰥔 {:%H:%M}",
        "tooltip": false
    },

    "clock#date": {
        "format": "󰃭 {:%a, %b %d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months":   "<span color='#cdd6f4'><b>{}</b></span>",
                "days":     "<span color='#cdd6f4'>{}</span>",
                "weeks":    "<span color='#89dceb'>W{}</span>",
                "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
                "today":    "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/powermenu.sh"
    }
}
