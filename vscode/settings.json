{
    // Python Configs
    "python.analysis.typeCheckingMode": "strict",
    "python.REPL.sendToNativeREPL": false,
    "python.createEnvironment.trigger": "off",
    "python.analysis.autoImportCompletions": true,
    // "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "python.analysis.completeFunctionParens": true,
    // Security Configs
    "security.workspace.trust.untrustedFiles": "open",
    // Files Configs
    "files.autoSave": "afterDelay",
    // Editor Configs
    "editor.cursorBlinking": "solid",
    "editor.inlineSuggest.enabled": false,
    "editor.suggest.showWords": true,
    "editor.suggest.showKeywords": true,
    "editor.suggestOnTriggerCharacters": true,
    "editor.acceptSuggestionOnEnter": "on",
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.lineNumbers": "relative",
    "editor.wordWrap": "on",
    "editor.minimap.enabled": false,
    "editor.autoClosingBrackets": "always",
    "editor.autoClosingComments": "always",
    "editor.autoClosingQuotes": "never",
    "editor.stickyScroll.enabled": false,
    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "editor.formatOnSave": true,
    // JSON Configs
    "json.schemaDownload.enable": true,
    "json.schemas": [],
    // GitHub Configs
    "github.copilot.enable": {
        "enabled": false
    },
    // Terminal Configs
    "security.allowedUNCHosts": [
        "wsl.localhost"
    ],
    "terminal.integrated.defaultProfile.windows": "Ubuntu (WSL)",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.stickyScroll.enabled": false,
    "terminal.integrated.defaultProfile.linux": "",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        // "Git Bash": {
        //     "source": "Git Bash"
        // },
        "Ubuntu (WSL)": {
            "path": "wsl.exe",
            "args": [
                "-d",
                "Ubuntu"
            ]
        }
    },
    // Workbench Configs
    "workbench.iconTheme": "material-icon-theme",
    "workbench.editor.empty.hint": "hidden",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.colorTheme": "GitHub Dark Dimmed",
    "workbench.startupEditor": "none",
    // Explorer Configs
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    // SQL Configs
    "sqltools.useNodeRuntime": true,
    // Notebook Configs
    "notebook.confirmDeleteRunningCell": false,
    // VIM Configs
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<Esc>"
            ],
            "when": [
                "editorFocus"
            ],
            "commands": [
                ":nohl"
            ], // Clears highlight of current search
            "silent": true
        }
    ],
    "vim.handleKeys": {
        "<C-a>": false,
        "<C-f>": false
    },
    // VIM QOL Options
    "vim.useSystemClipboard": true,
    "vim.incsearch": true,
    "vim.hlsearch": true,
    "vim.highlightedyank.enable": true,
    "vim.searchHighlightColor": "#f6ff0080",
    "vim.searchHighlightTextColor": "#fff",
    "vim.smartRelativeLine": true,
    "vim.matchpairs": "(:),{:},[:]",
    // Extensions Configs
    // "extensions.experimental.affinity": {
    //     "asvetliakov.vscode-neovim": 1 // For VSCode-Neovim extension, same in Omarchy
    // },
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1 // GREATLY improves vim performance
    },
    // Git Configs
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "workbench.secondarySideBar.showLabels": false,
    "remote.autoForwardPortsSource": "hybrid",
}