general {
    hide_cursor = true
}

animations {
    enabled = true
    bezier = linear, 1, 1, 0, 0
    animation = fadeIn, 1, 5, linear
    animation = fadeOut, 1, 5, linear
    animation = inputFieldDots, 0, 1, linear
    animation = inputFieldFade, 0, 1, linear
    # animation = inputFieldWidth, 1, 2, linear
}

background {
    monitor =
    path = ~/Pictures/wallpapers/wallhaven-9or96k.jpg
    blur_passes = 0
    brightness = 0.7
}

label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%H:%M")"
    font_size = 90
    font_family = Sans
    color = rgba(255, 255, 255, 0.9)

    position = 0, 80
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] echo "$(date +"%A, %B %d %Y")"
    font_size = 22
    font_family = Sans
    color = rgba(255, 255, 255, 0.6)

    position = 0, -20
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 140, 50
    outline_thickness = 2
    dots_size = 0.25
    dots_spacing = 0.2
    # dots_rounding = -1 # enable/disable dot animation
    outer_color = rgba(255, 255, 255, 0.3)
    inner_color = rgba(0, 0, 0, 0.4)
    font_color = rgba(255, 255, 255, 0.9)
    fade_on_empty = true  # enable/disable fade animation
    placeholder_text = Password # <i>Password...</i>
    hide_input = false
    check_color = rgba(255, 255, 255, 0.8)
    fail_color = rgba(255, 100, 100, 0.8)
    fail_text = Wrong password ($ATTEMPTS)

    position = 0, -140
    halign = center
    valign = center
}
