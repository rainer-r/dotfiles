-------------------------------
---- ENVIRONMENT VARIABLES ----
-------------------------------

-- ~/.config/hypr/modules/environment.lua
-- See https://wiki.hypr.land/Configuring/Advanced-and-Cool/Environment-variables/

-- Cursor
hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")

-- CPU/GPU
-- Optimus (Intel display, NVIDIA renders)
-- NVIDIA
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
hl.env("NVD_BACKEND", "direct")

-- Display Server: WLR: allow window managers (hypr)
-- to interact directly with GPU
hl.env("WLR_DRM_DEVICES", "/dev/dri/card1") -- Intel owns the display
hl.env("WLR_NO_HARDWARE_CURSORS", "1") -- Fix for Dota2 download crash

-- Wayland / XWayland compatibility
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto")
hl.env("XAUTHORITY", os.getenv("HOME") .. "/.Xauthority")

-- Steam / SDL
hl.env("STEAM_FORCE_DESKTOPUI_SCALING", "1.5")
hl.env("SDL_VIDEODRIVER", "x11")
hl.env("SDL_AUDIODRIVER", "pulse")
